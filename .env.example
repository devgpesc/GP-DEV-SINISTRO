# API Principal (Backend Proxy)
VITE_API_BASE_URL=http://localhost:3000/api

# Supabase (Banco de Dados)
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# --- BACKEND ONLY (Não expor no Frontend) ---

# --- INTEGRAÇÃO VEICULAR ---
# Provider 1: APIBrasil (https://placas.apibrasil.com.br/)
# Limite Free: ~100 req/dia
APIBRASIL_URL=https://gateway.apibrasil.com.br/api/v2/vehicles
APIBRASIL_TOKEN=seu_token_apibrasil

# Provider 2: Detran/Integrador (Requer credenciamento oficial)
DETRAN_API_URL=https://api.detran.sp.gov.br/rest
DETRAN_API_KEY=sua_chave_detran
DETRAN_CERT_PATH=./certs/certificado_digital.pfx

# Chaves de LLM (Inteligência Artificial)
GEMINI_API_KEY=sua_chave_google
OPENAI_API_KEY=sua_chave_openai
ANTHROPIC_API_KEY=sua_chave_anthropic
GROQ_API_KEY=sua_chave_groq
