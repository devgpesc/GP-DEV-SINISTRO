# =============================================================================
# FRONTEND (Vercel Build — prefixo VITE_ exposto ao browser)
# =============================================================================
VITE_API_BASE_URL=/api
VITE_APP_URL=https://eventos.escsistemas.com
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# =============================================================================
# BACKEND Vercel Serverless (api/ — NÃO usar prefixo VITE_)
# =============================================================================

# Origens separadas por virgula. Localhost e aceito automaticamente apenas fora de producao.
CORS_ALLOWED_ORIGINS=https://eventos.escsistemas.com
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# --- INTEGRAÇÃO VEICULAR ---
APIBRASIL_URL=https://gateway.apibrasil.com.br/api/v2/vehicles
APIBRASIL_TOKEN=seu_token_apibrasil

DETRAN_API_URL=https://api.detran.sp.gov.br/rest
DETRAN_API_KEY=sua_chave_detran
DETRAN_CERT_PATH=./certs/certificado_digital.pfx

# --- LLM (somente servidor) ---
GEMINI_API_KEY=sua_chave_google
OPENAI_API_KEY=sua_chave_openai
ANTHROPIC_API_KEY=sua_chave_anthropic
GROQ_API_KEY=sua_chave_groq

# =============================================================================
# SUPABASE EDGE FUNCTIONS (configuradas no dashboard Supabase)
# =============================================================================
# SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY (automáticas no deploy)

# =============================================================================
# LOCAL / AGENTE CURSOR (SQL automatico — NUNCA commitar .env.local)
# =============================================================================
# Cole UMA destas opcoes para o agente rodar SQL direto no seu Supabase:
#
# Opcao A (recomendada): Connection string URI
#   DATABASE_URL=postgresql://postgres.[REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
#
# Opcao B: senha do banco + URL do projeto
#   SUPABASE_URL=https://yxawavenbognqiihaesh.supabase.co
#   SUPABASE_DB_PASSWORD=sua_senha_do_banco
#
# Onde pegar:
#   Supabase → Project Settings → Database → Connection string (URI)
#   Supabase → Project Settings → API → service_role (para APIs locais)
#
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# SUPABASE_URL=https://yxawavenbognqiihaesh.supabase.co

# =============================================================================
# GITHUB ACTIONS SECRETS (Settings → Secrets and variables → Actions)
# =============================================================================
# VERCEL_TOKEN, VERCEL_ORG_ID, VERCEL_PROJECT_ID
# SUPABASE_ACCESS_TOKEN, SUPABASE_PROJECT_ID, SUPABASE_DB_PASSWORD
# VITE_SUPABASE_URL, VITE_SUPABASE_ANON_KEY
